# Groq: console.groq.com/keys (sin esta clave el RAG responde en modo simulado; RAGAS sí la necesita)
GROQ_API_KEY=

# LangSmith: trazas, tokens y precio de cada llamada
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=pdf-rag
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # si su cuenta está en la región EU

# Opcionales
# PDF_RAG_MODELO=openai/gpt-oss-120b
# PDF_RAG_EVALUADOR=openai/gpt-oss-120b
